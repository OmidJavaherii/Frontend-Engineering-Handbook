{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@meta/*": ["meta/*"],
      "@scripts/*": ["scripts/*"]
    }
  },
  "include": ["scripts/**/*.ts", "docs/.vitepress/**/*.ts", "docs/.vitepress/env.d.ts"],
  "exclude": ["docs/.vitepress/dist", "docs/.vitepress/cache", "node_modules"]
}

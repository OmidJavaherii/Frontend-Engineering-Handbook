{
  "name": "frontend-engineering-handbook",
  "version": "0.1.0",
  "private": true,
  "description": "Deep, first-principles handbook for modern frontend engineering",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "registry:seed": "tsx scripts/seed-meta.ts",
    "registry:validate": "tsx scripts/validate-registry.ts",
    "registry:sidebars": "tsx scripts/generate-sidebars.ts",
    "registry:topic-map": "tsx scripts/generate-topic-map.ts",
    "registry:knowledge-graph": "tsx scripts/generate-knowledge-graph.ts",
    "registry:links": "tsx scripts/check-cross-links.ts",
    "registry:all": "pnpm registry:validate && pnpm registry:sidebars && pnpm registry:topic-map && pnpm registry:knowledge-graph && pnpm registry:links",
    "scaffold:topic": "tsx scripts/scaffold-topic.ts",
    "scaffold:paths": "tsx scripts/generate-learning-path-pages.ts",
    "content:publish": "tsx scripts/publish-topics.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "pnpm registry:all && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitepress": "^1.5.0",
    "vue": "^3.5.13",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  }
}

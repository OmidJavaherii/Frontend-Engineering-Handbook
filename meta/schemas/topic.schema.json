{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontend-engineering-handbook.local/schemas/topic.schema.json",
  "title": "Topic",
  "type": "object",
  "required": [
    "id",
    "title",
    "module",
    "path",
    "difficulty",
    "estimated_reading_minutes",
    "estimated_implementation_minutes",
    "status",
    "order"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{2}-[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"
    },
    "title": { "type": "string", "minLength": 1 },
    "module": {
      "type": "string",
      "pattern": "^[0-9]{2}-[a-z0-9-]+$"
    },
    "path": { "type": "string" },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "junior", "mid", "senior", "expert"]
    },
    "estimated_reading_minutes": { "type": "integer", "minimum": 0 },
    "estimated_implementation_minutes": { "type": "integer", "minimum": 0 },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "recommended_next": { "type": "array", "items": { "type": "string" } },
    "parents": { "type": "array", "items": { "type": "string" } },
    "children": { "type": "array", "items": { "type": "string" } },
    "related": { "type": "array", "items": { "type": "string" } },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "dependents": { "type": "array", "items": { "type": "string" } },
    "advanced": { "type": "array", "items": { "type": "string" } },
    "beginner_path": { "type": "string" },
    "perspective_of": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "status": {
      "type": "string",
      "enum": ["stub", "outline", "draft", "reviewed", "published"]
    },
    "order": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontend-engineering-handbook.local/schemas/tag.schema.json",
  "title": "Tag",
  "type": "object",
  "required": ["id", "label"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "label": { "type": "string" },
    "description": { "type": "string" }
  },
  "additionalProperties": false
}
